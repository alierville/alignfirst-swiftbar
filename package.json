{
  "name": "workspace-bar",
  "private": true,
  "type": "module",
  "description": "AlignFirst workspace endpoints in the macOS menu bar (SwiftBar)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test --disable-warning=ExperimentalWarning 'test/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test:e2e": "node --test --disable-warning=ExperimentalWarning 'test/e2e/*.e2e.ts'"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "24.10.1",
    "alignfirst": "0.18.0",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
