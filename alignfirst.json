{
  "$schema": "https://cdn.jsdelivr.net/npm/alignfirst/schemas/alignfirst-v1.schema.json",
  "schemaVersion": 1,
  "conventions": {
    "ticketIdPattern": "^\\d+$",
    "git": {
      "defaultBranch": "main",
      "branchNameTemplate": "{TICKET_ID}/{slug-1-3-words}",
      "commit": { "style": "conventionalCommit", "ticketReference": "bracketedHash" },
      "agentCoauthoring": false
    }
  },
  "plans": { "autoArchive": true },
  "assistantInstructionsFile": "DEVELOPERS.md"
}
